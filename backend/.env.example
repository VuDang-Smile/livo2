# Service Configuration
SERVICE_NAME=livo-backend
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# File Storage
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MAX_UPLOAD_SIZE=2147483648
SINGLE_VERSION_MODE=true

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=livo_backend
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=livo/maps
MQTT_TOPIC_VEHICLES=livo/vehicles
# MQTT_USERNAME=
# MQTT_PASSWORD=
